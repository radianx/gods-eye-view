+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import {
+  STREET_VIEW_CACHE_MAX_ENTRIES,
+  STREET_VIEW_CACHE_MS,
+  createStreetViewFrameCache,
+  normalizeHeadingDeg,
+  resolveStreetViewTarget,
+  streetViewCacheKey,
+  streetViewPose,
+} from '../../server/providers/cctv/streetview.js';
+import { GOOGLE_DEFAULT_PER_MIN } from '../../server/providers/places/google-key.js';
+
+test('an unregistered camera id cannot spend a Street View lookup', () => {
+  assert.equal(resolveStreetViewTarget(undefined), null);
+  assert.equal(resolveStreetViewTarget(null), null);
+});
+
+test('a registered camera resolves to its own recorded pose', () => {
+  assert.deepEqual(resolveStreetViewTarget({ lat: 30.2672, lon: -97.7431 }), {
+    lat: 30.2672,
+    lon: -97.7431,
+  });
+});
+
+test('client-supplied coordinates cannot steer a billable lookup', () => {
+  // The browser sends lat/lon on every frame; the resolver is handed the
+  // registered record, so whatever arrived on the query string is not part of
+  // the decision at all. A source carrying an attacker's target only resolves
+  // when the catalog itself holds it.
+  const registered = { lat: 30.2672, lon: -97.7431, id: 'austin-1' };
+  const target = resolveStreetViewTarget(registered);
+  assert.deepEqual(target, { lat: 30.2672, lon: -97.7431 });
+});
+
+test('a finite number that is not a coordinate is refused before Google sees it', () => {
+  for (const bad of [
+    { lat: 91, lon: 0 },
+    { lat: -91, lon: 0 },
+    { lat: 0, lon: 181 },
+    { lat: 0, lon: -181 },
+  ]) {
+    assert.equal(resolveStreetViewTarget(bad), null, JSON.stringify(bad));
+  }
+});
+
+test('a camera with no usable pose is refused rather than guessed at', () => {
+  for (const bad of [
+    { lat: undefined, lon: 0 },
+    { lat: 0, lon: null },
+    { lat: Number.NaN, lon: 0 },
+    { lat: 'thirty', lon: 0 },
+    { lat: Number.POSITIVE_INFINITY, lon: 0 },
+  ]) {
+    assert.equal(resolveStreetViewTarget(bad), null, JSON.stringify(bad));
+  }
+});
+
+test('a bearing wraps instead of clamping, because a bearing is periodic', () => {
+  assert.equal(normalizeHeadingDeg(40), 40);
+  assert.equal(normalizeHeadingDeg(400), 40);
+  assert.equal(normalizeHeadingDeg(-90), 270);
+  assert.equal(normalizeHeadingDeg(360), 0);
+  assert.equal(normalizeHeadingDeg(-720.5), 359.5);
+});
+
+test('an unreadable bearing becomes due north rather than reaching Google', () => {
+  for (const bad of [undefined, null, Number.NaN, 'north', {}, Infinity]) {
+    assert.equal(normalizeHeadingDeg(bad), 0, String(bad));
+  }
+});
+
+test('the shared Google budget clears the demand the CCTV layer generates', () => {
+  // 16 ambient cards (CCTV_AMBIENT_CARD_DRAIN_CAP) refreshing every 10s
+  // (ACTIVE_FRAME_REFRESH_MS) is 96 fallback frames a minute for one viewer
+  // whose cameras have all lost their upstreams. With the frame cache only the
+  // first refresh of each pose is a lookup, so the steady state is 16 lookups
+  // per cache lifetime. Either figure must sit under the default Google cap,
+  // or normal use of the layer would starve Places search on the same budget.
+  const uncachedPerMinute = 16 * (60_000 / 10_000);
+  const cachedPerMinute = 16 * (60_000 / STREET_VIEW_CACHE_MS);
+  assert.equal(uncachedPerMinute, 96);
+  assert.ok(uncachedPerMinute < GOOGLE_DEFAULT_PER_MIN);
+  assert.ok(cachedPerMinute <= 4, `${cachedPerMinute} lookups/min`);
+});
+
+test('the pose sent to Google is clamped and wrapped, with the route defaults', () => {
+  assert.deepEqual(streetViewPose({ heading: 360, fov: 200, pitch: -90 }), {
+    heading: 0,
+    fov: 120,
+    pitch: -40,
+  });
+  assert.deepEqual(streetViewPose({ heading: NaN, fov: NaN, pitch: NaN }), {
+    heading: 0,
+    fov: 80,
+    pitch: 0,
+  });
+});
+
+test('a cache key changes with every parameter that changes the image', () => {
+  const target = { lat: 30.2672, lon: -97.7431 };
+  const pose = { heading: 90, fov: 80, pitch: 0 };
+  const base = streetViewCacheKey('cam-1', target, pose);
+  assert.equal(base, streetViewCacheKey('cam-1', { ...target }, { ...pose }));
+  for (const [cameraId, t, p] of [
+    ['cam-2', target, pose],
+    ['cam-1', { ...target, lat: 30.2673 }, pose],
+    ['cam-1', target, { ...pose, heading: 91 }],
+    ['cam-1', target, { ...pose, fov: 81 }],
+    ['cam-1', target, { ...pose, pitch: -1 }],
+  ]) {
+    assert.notEqual(streetViewCacheKey(cameraId, t, p), base);
+  }
+});
+
+test('a cached frame is reused inside its TTL and dropped after it', () => {
+  let clock = 1_000_000;
+  const cache = createStreetViewFrameCache({ now: () => clock });
+  const frame = {
+    ok: true,
+    body: Buffer.from('jpeg'),
+    contentType: 'image/jpeg',
+  };
+  assert.equal(cache.get('k'), null);
+  cache.set('k', frame);
+  clock += STREET_VIEW_CACHE_MS;
+  assert.equal(cache.get('k'), frame, 'still fresh at exactly the TTL');
+  clock += 1;
+  assert.equal(cache.get('k'), null, 'expired one millisecond later');
+  assert.equal(cache.size, 0, 'an expired entry is removed, not kept');
+});
+
+test('the frame cache stays bounded and evicts the oldest frame first', () => {
+  const cache = createStreetViewFrameCache();
+  for (let i = 0; i < STREET_VIEW_CACHE_MAX_ENTRIES + 10; i += 1)
+    cache.set(`k${i}`, { ok: true, i });
+  assert.equal(cache.size, STREET_VIEW_CACHE_MAX_ENTRIES);
+  assert.equal(cache.get('k0'), null);
+  assert.equal(cache.get('k9'), null);
+  assert.equal(cache.get('k10')?.i, 10);
+  // Refreshing an entry protects it from the next eviction.
+  cache.set('k10', { ok: true, i: 10 });
+  cache.set('fresh', { ok: true });
+  assert.equal(cache.get('k10')?.i, 10);
+  assert.equal(cache.get('k11'), null);
+});
diff --git a/src/data/cctvStreetViewRoute.test.mjs b/src/data/cctvStreetViewRoute.test.mjs
new file mode 100644
index 00000000..a991b722
--- /dev/null
+++ b/src/data/cctvStreetViewRoute.test.mjs
@@ -0,0 +1,176 @@
+// /api/cctv/frame/:id falls back to a Google Street View still when a camera's
+// own upstream has no frame. That lookup is billed to the operator's key, so
+// the route aims it at the camera the catalog registered, never at whatever
+// lat/lon the request carries. These drive the real route end to end and read
+// the URL that would have gone to Google.
+//
+// Run with: npm test   (node --test)
+import { test } from 'node:test';
+import assert from 'node:assert/strict';
+import { cctvProxy } from '../../server/providers/cctv.js';
+import { GOOGLE_DEFAULT_PER_MIN } from '../../server/providers/places/google-key.js';
+
+// The Google budget is built once per process on first use; pin the default
+// so a value exported in the shell cannot change what these tests measure.
+delete process.env.GEV_RATELIMIT_GOOGLE_PER_MIN;
+
+// No snapshot and no still URL, so every frame request reaches Street View.
+const CAMERA = {
+  id: 'streetview-fixture',
+  name: 'Street View fixture',
+  city: 'Austin',
+  lat: 30.2672,
+  lon: -97.7431,
+  headingDeg: 90,
+  feedType: 'image',
+};
+
+const STREET_VIEW = 'https://maps.googleapis.com/maps/api/streetview';
+
+/** Collects what a handler wrote, the way a Node ServerResponse would. */
+function recordingResponse() {
+  const chunks = [];
+  let finished;
+  const done = new Promise((resolve) => {
+    finished = resolve;
+  });
+  const res = {
+    statusCode: 0,
+    headers: {},
+    body: Buffer.alloc(0),
+    writeHead(status, headers) {
+      res.statusCode = status;
+      res.headers = headers || {};
+    },
+    write(chunk) {
+      chunks.push(Buffer.from(chunk));
+      return true;
+    },
+    end(chunk) {
+      if (chunk) chunks.push(Buffer.from(chunk));
+      res.body = Buffer.concat(chunks);
+      finished();
+    },
+    on() {},
+    once() {},
+    emit() {},
+    destroy() {},
+  };
+  return { res, done };
+}
+
+/** Mount the real provider over the fixture camera with a server key set. */
+function mount(t) {
+  const names = [
+    'CCTV_SOURCES_JSON',
+    'CCTV_SOURCES_FILE',
+    'CCTV_FORCE_AUSTIN',
+    'GOOGLE_MAPS_SERVER_API_KEY',
+    'GOOGLE_MAPS_API_KEY',
+  ];
+  const before = Object.fromEntries(
+    names.map((name) => [name, process.env[name]]),
+  );
+  process.env.CCTV_SOURCES_JSON = JSON.stringify([CAMERA]);
+  process.env.CCTV_SOURCES_FILE = 'absent-source-file.json';
+  process.env.CCTV_FORCE_AUSTIN = '0';
+  process.env.GOOGLE_MAPS_SERVER_API_KEY = 'fixture-street-view-key';
+  delete process.env.GOOGLE_MAPS_API_KEY;
+
+  const nativeFetch = globalThis.fetch;
+  const streetView = [];
+  globalThis.fetch = async (url) => {
+    const target = new URL(String(url));
+    if (`${target.origin}${target.pathname}` !== STREET_VIEW)
+      throw new Error(`unexpected upstream request: ${target.origin}`);
+    streetView.push(target);
+    return new Response(Buffer.from('jpeg-bytes'), {
+      headers: { 'content-type': 'image/jpeg' },
+    });
+  };
+  t.after(() => {
+    globalThis.fetch = nativeFetch;
+    for (const name of names) {
+      if (before[name] === undefined) delete process.env[name];
+      else process.env[name] = before[name];
+    }
+  });
+
+  let handler = null;
+  cctvProxy().configureServer({
+    middlewares: {
+      use: (_route, fn) => {
+        handler = fn;
+      },
+    },
+  });
+  assert.ok(handler, 'the CCTV provider must mount a middleware');
+
+  const frame = async (path) => {
+    const { res, done } = recordingResponse();
+    await handler(
+      {
+        url: path,
+        headers: {},
+        method: 'GET',
+        socket: { remoteAddress: '10.0.0.7' },
+        on() {},
+      },
+      res,
+    );
+    await done;
+    return res;
+  };
+  return { frame, streetView };
+}
+
+test('lat/lon on the frame request do not move the Street View lookup', async (t) => {
+  const app = mount(t);
+  // What a hand-written query aimed at someone else's address would send.
+  const res = await app.frame(
+    `/frame/${CAMERA.id}?lat=48.858400&lon=2.294500&heading=90&ts=1`,
+  );
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.headers['X-CCTV-Source'], 'streetview');
+  assert.equal(app.streetView.length, 1, 'one lookup reached Google');
+  assert.equal(
+    app.streetView[0].searchParams.get('location'),
+    `${CAMERA.lat},${CAMERA.lon}`,
+    'the lookup must be aimed at the registered camera, not the query string',
+  );
+});
+
+test('an unregistered camera id does not reach Google, whatever lat/lon it carries', async (t) => {
+  const app = mount(t);
+  const res = await app.frame(
+    '/frame/not-a-camera?lat=48.858400&lon=2.294500&heading=90&ts=1',
+  );
+  assert.equal(res.statusCode, 200);
+  assert.equal(res.headers['X-CCTV-Source'], 'synthetic');
+  assert.equal(app.streetView.length, 0);
+});
+
+test('the bearing the browser rounds up to 360 is sent to Google as 0', async (t) => {
+  const app = mount(t);
+  await app.frame(`/frame/${CAMERA.id}?heading=360&ts=1`);
+  assert.equal(app.streetView[0].searchParams.get('heading'), '0');
+});
+
+test('a card refresh at the same pose is served from cache, not bought again', async (t) => {
+  const app = mount(t);
+  // Each 10 s refresh carries a new `ts`; the picture it asks for does not
+  // change. Run past the per-client Google budget: a cached answer must not
+  // count against it, or a viewer on the fallback would be cut off by their own
+  // card refreshing.
+  for (let ts = 0; ts <= GOOGLE_DEFAULT_PER_MIN + 5; ts += 1) {
+    const res = await app.frame(`/frame/${CAMERA.id}?heading=90&ts=${ts}`);
+    assert.equal(res.headers['X-CCTV-Source'], 'streetview', `refresh ${ts}`);
+    assert.equal(res.body.toString(), 'jpeg-bytes');
+  }
+  assert.equal(app.streetView.length, 1, 'one lookup for one pose');
+
+  // A different pose is a different picture, so it is bought once as well.
+  await app.frame(`/frame/${CAMERA.id}?heading=180&ts=1`);
+  await app.frame(`/frame/${CAMERA.id}?heading=180&ts=2`);
+  assert.equal(app.streetView.length, 2);
+});
